# ================================
# Dustless Environment Variables
# ================================
# Copy this file to .env and fill in your values

# ============ API Server ============
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# CORS origin for frontend (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# ============ RPC URLs ============
# Override default public RPCs with your own for better reliability
# Get free RPC URLs from: Alchemy, Infura, QuickNode, or use public ones

# Target chains (where users consolidate to)
RPC_BASE=https://mainnet.base.org
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_OPTIMISM=https://mainnet.optimism.io

# Source chains (where dust might be stuck)
RPC_BLAST=https://rpc.blast.io
RPC_MODE=https://mainnet.mode.network
RPC_ZORA=https://rpc.zora.energy
RPC_LINEA=https://rpc.linea.build
RPC_ZKSYNC=https://mainnet.era.zksync.io
RPC_SCROLL=https://rpc.scroll.io

# ============ Bridge Providers ============

# Socket/Bungee API Key (required for Socket provider)
# Get one at: https://sockettech.notion.site/Socket-API-Key-Request
SOCKET_API_KEY=sktsec_ScpfLF2VJ9HIJRFUKeR8phLfSvpCaBp6eqcxy4EOXBvc_api

# LI.FI Base URL (optional, uses default if not set)
# LIFI_BASE_URL=https://li.quest/v1

# LI.FI API Key (optional, for higher rate limits)
# Get one at: https://li.fi/
# LIFI_API_KEY=823a334c-d18c-4dd9-88a0-fd5e1f9036ca.9675bbed-85a8-4d44-9466-4e9ce2087a0d

# ============ Frontend (NEXT_PUBLIC_ prefix required) ============

# API URL for frontend to connect to backend (REST + Socket.IO)
NEXT_PUBLIC_API_URL=http://localhost:4000

# WalletConnect Project ID (required for WalletConnect connector)
# Get one at: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=ba6cef79a1c32303c198538b3d0757de

# ============ Optional: Analytics & Monitoring ============

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=

# PostHog API Key for analytics (optional)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============ Optional: Price Oracle ============

# CoinGecko API Key for price data (optional, free tier available)
# Get one at: https://www.coingecko.com/en/api
COINGECKO_API_KEY=CG-U5n4FCERhB5qt7N2vvVpVngD

# CoinMarketCap API Key (alternative price source)
# Get one at: https://coinmarketcap.com/api/
# COINMARKETCAP_API_KEY=

# ============ Production Only ============

# Redis URL for session/cache (production)
# REDIS_URL=redis://localhost:6379

# Database URL if needed in future
# DATABASE_URL=postgresql://user:pass@localhost:5432/dustless
